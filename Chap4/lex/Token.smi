_require "basis.smi"
structure Token =
struct

datatype token
  = EOF | COMMA | PERIOD | DOTS | COLON | SEMICOLON
  | EQ | GE | LBRACKET | RBRACKET | UNDERBAR | BAR
  | KEYWORD of string | ID of string | STRING of string
  | REAL of string | INT of string | SPECIAL of string
val toString : token -> string

end
